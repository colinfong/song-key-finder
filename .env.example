# Copy this file to .env and fill in your Spotify app's Client ID. .env is ignored by Git.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add this Redirect URI to the app, using the port you run the server on:
#      http://127.0.0.1:8765/auth/spotify/callback
# 3. Tick "Web API", save, and copy the Client ID below. No client secret is needed.
SPOTIFY_CLIENT_ID=
